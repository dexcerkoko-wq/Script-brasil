-- LocalScript - Teleporte em linha +2, Noclip e Velocidade

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

-- =========================
-- VELOCIDADE ALTA
-- =========================
humanoid.WalkSpeed = 80

-- =========================
-- NOCLIP
-- =========================
RunService.Stepped:Connect(function()
	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end)

-- =========================
-- POSIÇÕES EM LINHA (+2)
-- =========================
local startPosition = Vector3.new(-470, -6, 221) -- posição inicial
local totalPoints = 8 -- quantidade de pontos
local step = 2 -- valor do +2

local teleportPoints = {}

for i = 0, totalPoints - 1 do
	table.insert(teleportPoints, startPosition + Vector3.new(step * i, 0, 0))
end

-- =========================
-- TELEPORTE
-- =========================
local index = 1

local function teleport()
	root.CFrame = CFrame.new(teleportPoints[index])

	print("Teleportado para:", teleportPoints[index])

	index += 1
	if index > #teleportPoints then
		index = 1
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.K then
		teleport()
	end
end)
