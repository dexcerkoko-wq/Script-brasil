-- LocalScript - Teleporte em sequência e volta para a posição original

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

-- Lista das SUAS novas coordenadas
local teleportPoints = {
	Vector3.new(-347, -6, 113),
	Vector3.new(-347, -6, 218),
	Vector3.new(-346, -6, 10),
	Vector3.new(-347, -6, -97),
	Vector3.new(-470, -6, -102),
	Vector3.new(-471, -6, 2),
	Vector3.new(-470, -6, 114),
	Vector3.new(-470, -6, 220)
}

local debounce = false -- impede spam da tecla

local function teleportSequence()
	if debounce then return end
	debounce = true

	-- Salva posição original
	local originalPosition = root.CFrame

	-- Passa por todas as coordenadas
	for _, pos in ipairs(teleportPoints) do
		root.CFrame = CFrame.new(pos)
		task.wait(0.3) -- tempo entre cada teleporte (ajuste se quiser)
	end

	-- Volta para onde o player estava
	task.wait(0.3)
	root.CFrame = originalPosition

	debounce = false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.K then
		teleportSequence()
	end
end)
