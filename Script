-- LocalScript - Teleporte + Noclip + Velocidade

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- Espera o personagem carregar
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

-- =========================
-- VELOCIDADE ALTA
-- =========================
humanoid.WalkSpeed = 80 -- padrão é 16, você pode aumentar mais se quiser

-- =========================
-- NOCLIP
-- =========================
RunService.Stepped:Connect(function()
	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end)

-- =========================
-- PRINT DA POSIÇÃO
-- =========================
print("Posição inicial:", root.Position)

-- =========================
-- TELEPORTES
-- =========================
local teleportPoints = {
	Vector3.new(-470, -6, 221),
	Vector3.new(-471, -6, 112)
}

local index = 1

local function teleport()
	root.CFrame = CFrame.new(teleportPoints[index])

	index += 1
	if index > #teleportPoints then
		index = 1
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.K then
		teleport()
	end
end)
